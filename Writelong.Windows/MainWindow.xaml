<Window
    x:Class="Writelong.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Writelong">
    <ScrollViewer>
        <StackPanel Spacing="20" Padding="32" Width="620">
            <StackPanel Spacing="4">
                <TextBlock Text="Writelong" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Private, local writing assistance for Windows."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar IsOpen="True"
                     IsClosable="False"
                     Severity="Informational"
                     Title="Setup"
                     Message="Enable Accessibility permission to let Writelong offer suggestions in supported apps." />

            <StackPanel Spacing="10">
                <TextBlock Text="Writing assistance" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ToggleSwitch x:Name="CompletionsToggle"
                              Header="Enable writing suggestions"
                              Toggled="CompletionsToggle_Toggled" />
                <ToggleSwitch x:Name="LaunchAtLoginToggle"
                              Header="Start Writelong when I sign in"
                              Toggled="LaunchAtLoginToggle_Toggled" />
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ComboBox x:Name="MenuIconPicker"
                          Header="Notification area icon"
                          SelectionChanged="MenuIconPicker_SelectionChanged">
                    <ComboBoxItem Content="Writelong logo" Tag="brand" />
                    <ComboBoxItem Content="Pen" Tag="pen" />
                    <ComboBoxItem Content="Sparkle" Tag="sparkle" />
                    <ComboBoxItem Content="Document" Tag="document" />
                </ComboBox>
            </StackPanel>

            <Button Content="Check for updates" HorizontalAlignment="Left" Click="CheckForUpdates_Click" />
        </StackPanel>
    </ScrollViewer>
</Window>
